# -*- coding: mbcs -*-
from part import *
from material import *
from section import *
from assembly import *
from step import *
from interaction import *
from load import *
from mesh import *
from optimization import *
from job import *
from sketch import *
from visualization import *
from connectorBehavior import *
mdb.Model(name='PlateModel_R3_E210000_M4')
mdb.models['PlateModel_R3_E210000_M4'].ConstrainedSketch(name='__profile__', 
    sheetSize=200.0)
mdb.models['PlateModel_R3_E210000_M4'].sketches['__profile__'].rectangle(
    point1=(0.0, 0.0), point2=(100.0, 50.0))
mdb.models['PlateModel_R3_E210000_M4'].sketches['__profile__'].CircleByCenterPerimeter(
    center=(50.0, 25.0), point1=(53.0, 25.0))
mdb.models['PlateModel_R3_E210000_M4'].Part(dimensionality=TWO_D_PLANAR, name=
    'Plate', type=DEFORMABLE_BODY)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].BaseShell(sketch=
    mdb.models['PlateModel_R3_E210000_M4'].sketches['__profile__'])
mdb.models['PlateModel_R3_E210000_M4'].Material(name='Steel')
mdb.models['PlateModel_R3_E210000_M4'].materials['Steel'].Elastic(table=((
    210000.0, 0.3), ))
mdb.models['PlateModel_R3_E210000_M4'].HomogeneousSolidSection(material='Steel'
    , name='PlateSection', thickness=None)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].Set(faces=
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].faces, name='Set-1')
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].SectionAssignment(offset=
    0.0, offsetField='', offsetType=MIDDLE_SURFACE, region=
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].sets['Set-1'], 
    sectionName='PlateSection', thicknessAssignment=FROM_SECTION)
mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.DatumCsysByDefault(
    CARTESIAN)
mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.Instance(dependent=ON, 
    name='PlateModel_R3_E210000_M4', part=
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'])
mdb.models['PlateModel_R3_E210000_M4'].StaticStep(name='Tension', previous=
    'Initial')
mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.Set(edges=
    mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.instances['PlateModel_R3_E210000_M4'].edges.getSequenceFromMask(
    mask=('[#4 ]', ), ), name='RightEdge')
mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.Set(edges=
    mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.instances['PlateModel_R3_E210000_M4'].edges.getSequenceFromMask(
    mask=('[#10 ]', ), ), name='LeftEdge')
mdb.models['PlateModel_R3_E210000_M4'].DisplacementBC(amplitude=UNSET, 
    createStepName='Tension', distributionType=UNIFORM, fieldName='', fixed=OFF
    , localCsys=None, name='Traction', region=
    mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.sets['RightEdge'], u1=
    0.1, u2=UNSET, ur3=UNSET)
mdb.models['PlateModel_R3_E210000_M4'].DisplacementBC(amplitude=UNSET, 
    createStepName='Tension', distributionType=UNIFORM, fieldName='', fixed=OFF
    , localCsys=None, name='Clamp', region=
    mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.sets['LeftEdge'], u1=
    0.0, u2=0.0, ur3=UNSET)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].seedPart(deviationFactor=
    0.1, minSizeFactor=0.1, size=4.0)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].setMeshControls(
    elemShape=QUAD, regions=
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].faces)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].setElementType(elemTypes=
    (ElemType(elemCode=CPS4R, elemLibrary=STANDARD, secondOrderAccuracy=OFF, 
    hourglassControl=DEFAULT, distortionControl=DEFAULT), ), regions=(
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].faces, ))
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].seedEdgeBySize(
    deviationFactor=0.1, edges=
    mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].edges.getSequenceFromMask(
    mask=('[#1 ]', ), ), minSizeFactor=0.1, size=2.0)
mdb.models['PlateModel_R3_E210000_M4'].parts['Plate'].generateMesh()
mdb.models['PlateModel_R3_E210000_M4'].rootAssembly.regenerate()
mdb.Job(atTime=None, contactPrint=OFF, description=
    'Plate with hole radius 3.0, Young modulus 210000.0 and mesh size 4.0', 
    echoPrint=OFF, explicitPrecision=SINGLE, getMemoryFromAnalysis=True, 
    historyPrint=OFF, memory=90, memoryUnits=PERCENTAGE, model=
    'PlateModel_R3_E210000_M4', modelPrint=OFF, multiprocessingMode=DEFAULT, 
    name='PlateJob_R3_E210000_M4', nodalOutputPrecision=SINGLE, numCpus=1, 
    numGPUs=0, queue=None, resultsFormat=ODB, scratch='', type=ANALYSIS, 
    userSubroutine='', waitHours=0, waitMinutes=0)
mdb.jobs['PlateJob_R3_E210000_M4'].submit()
mdb.jobs['PlateJob_R3_E210000_M4'].waitForCompletion()
